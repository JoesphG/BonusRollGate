package-as: BonusRollGate

# Release notes come from the hand-written changelog, not commit messages.
manual-changelog: CHANGELOG.md

# Libraries are vendored in Libs/, not pulled as externals, so a clone drops
# straight into Interface/AddOns. check-libs.yml watches them for updates.

ignore:
  - .github
  - .gitignore
  - .luacheckrc
  - .luarc.json
  - .pkgmeta
  - .styluaignore
  - Makefile
  - README.md
  - images
  - stylua.toml
  - tests
